NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@ep-example.region.neon.tech/neondb?sslmode=require
# PREVIEW_DATABASE_URL=postgresql://user:password@preview-ep.region.neon.tech/neondb?sslmode=require
POSTGRES_AUTH_ENABLED=true
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters
CLIENT_URL=http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-24-characters
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SETUP_TOKEN=replace-with-a-random-production-setup-token
EMAIL_FROM=The Editing Table <no-reply@example.com>
