{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://t-he-editing-table-server.vercel.app/api/$1" },
    { "source": "/health", "destination": "https://t-he-editing-table-server.vercel.app/api/health" },
    { "source": "/uploads/(.*)", "destination": "https://t-he-editing-table-server.vercel.app/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
