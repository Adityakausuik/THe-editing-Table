# Root defaults copied by local tooling if needed.
NODE_ENV=development

# Client
VITE_API_URL=http://localhost:5000/api

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/the-editing-table
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
TWO_FACTOR_ENCRYPTION_KEY=replace-with-an-independent-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@theeditingtable.com
ADMIN_PASSWORD=AdminPassword123!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
GMAIL_APP_PASSWORD=your-16-character-app-password
