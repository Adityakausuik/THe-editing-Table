# ==============================================================================
# FRONTEND / VITE (Public - Exposed to browser bundle)
# ==============================================================================
# In production on Vercel, leave empty to automatically use relative "/api",
# or set to the custom production API domain (e.g. https://theeditingtable.com/api).
# NEVER expose backend secrets, passwords, or private keys in VITE_* variables!
VITE_API_URL=http://127.0.0.1:5000/api

# ==============================================================================
# BACKEND / SERVER (Private - Kept on server/Vercel serverless function only)
# ==============================================================================
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/the-editing-table
# In PostgreSQL Production, MONGODB_URI remains the Atlas rollback and GridFS media connection.
# Preview must use a separate staging Atlas URI; it never falls back to MONGODB_URI.
# GRIDFS_MONGODB_URI=mongodb+srv://... # Optional Production override for the GridFS connection
# PREVIEW_GRIDFS_MONGODB_URI=mongodb+srv://... # Separate Preview-only GridFS database
DATABASE_BACKEND=mongodb
# PostgreSQL cutover settings are server-only. Keep DATABASE_BACKEND=mongodb
# until Preview import, route checks, rollback, and production gates are verified.
# DATABASE_URL=postgresql://user:password@host.example/database
# PREVIEW_DATABASE_URL=postgresql://user:password@preview-host.example/database
# POSTGRES_AUTH_ENABLED=false
# PREVIEW_POSTGRES_AUTH_ENABLED=false
# Blob tokens are optional. When absent, persistent uploads use GridFS.
# BLOB_READ_WRITE_TOKEN=replace-with-public-blob-store-token
# BLOB_PRIVATE_READ_WRITE_TOKEN=replace-with-private-blob-store-token
# CRON_SECRET=replace-with-a-random-secret-at-least-16-characters
# MIGRATION_WRITE_FREEZE=false

# Authentication & Session Security
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@theeditingtable.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Admin 2FA is enabled by default. Do not disable it in production.
ADMIN_2FA_ENABLED=true

# Two-Factor Authentication & Email OTP (Required when ADMIN_2FA_ENABLED=true)
TWO_FACTOR_ENCRYPTION_KEY=replace-with-an-independent-random-secret-at-least-32-characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=replace-with-provider-app-password
GMAIL_APP_PASSWORD=replace-with-provider-app-password
EMAIL_FROM=The Editing Table <no-reply@example.com>

